# Copy this file to backend/.env and replace the example values with local values.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=research_portal
DJANGO_DB_USER=research_portal_app
DJANGO_DB_PASSWORD=replace-with-a-strong-local-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
