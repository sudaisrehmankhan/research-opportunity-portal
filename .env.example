# Copy this file to .env and replace the development secret with a fresh value.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# SQLite is the default. Uncomment and set these only when using MySQL.
# DJANGO_DB_ENGINE=django.db.backends.mysql
# DJANGO_DB_NAME=research_portal
# DJANGO_DB_USER=your_local_mysql_user
# DJANGO_DB_PASSWORD=your_local_mysql_password
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=3306
